# Copy to .env.local (gitignored) and fill in the project you want to run against.
#
# Both variables are REQUIRED. src/lib/supabase.ts throws at startup if either is
# missing — it no longer falls back to a hardcoded project. That fallback pointed
# at production, so any deploy that forgot its env vars silently connected real
# users to the production database. (audit H5)
#
# Local dev via the Supabase CLI needs no values here: `supabase start` prints
# its own URL and anon key, which the CLI's env handling picks up.
#
# These are publishable/anon keys. They are not secrets, but that is only true
# while RLS is correct — the key is the sole credential the browser holds. Treat
# it as configuration and keep real values out of this file; it is committed.

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_<your-key>

# Optional — VASTOS platform API base URL.
VITE_VASTOS_API_URL=
